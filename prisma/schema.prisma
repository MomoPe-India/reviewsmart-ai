datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  password     String
  userIdTag    String?           @unique // Unique identifier: mobile number (e.g. 9876543210) or agent code (MKT-01)
  pinCode      String?           // Hashed 4-6 digit numeric PIN
  phone        String?
  role         String            @default("BUSINESS_OWNER") // "SUPER_ADMIN" | "BUSINESS_OWNER" | "MARKETING_AGENT"
  agentCode    String?           // Unique code for agents (e.g. MKT-01)
  referredBy   String?           // Agent ID who onboarded the merchant
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  businesses   Business[]
  subscription UserSubscription?
  upiPayments  UpiPayment[]
}

model SubscriptionPlan {
  id            String             @id @default(cuid())
  name          String             // e.g. "Starter", "Pro Reseller", "Unlimited"
  price         Float              @default(0)
  currency      String             @default("USD")
  durationDays  Int                @default(30)
  maxCards      Int                @default(1)
  features      String             @default("[\"AI Review Generation\",\"Negative Review Shield\",\"Smart QR Code\",\"Print Studio\"]")
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions UserSubscription[]
}

model UserSubscription {
  id        String           @id @default(cuid())
  userId    String           @unique
  planId    String
  status    String           @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "CANCELLED"
  startDate DateTime         @default(now())
  endDate   DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
}

model Business {
  id                 String            @id @default(cuid())
  userId             String
  name               String
  slug               String            @unique
  tagline            String?           @default("Review our service & share your experience!")
  category           String?           @default("Local Business")
  logoUrl            String?
  primaryColor       String            @default("#4f46e5")
  googlePlaceId      String?
  googleReviewUrl    String?
  googleAddress      String?
  phone              String?
  whatsapp           String?
  instagram          String?
  facebook           String?
  website            String?
  minRatingForGoogle Int               @default(4)
  keywords           String            @default("exceptional service, highly recommended, friendly staff, prompt delivery, great experience")
  tagChips           String            @default("Friendly Staff,Fast Service,Great Quality,Fair Pricing,Clean Ambiance")
  reviewPromptTone   String            @default("friendly") // "enthusiastic" | "professional" | "friendly" | "brief"
  isPaid             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks          PrivateFeedback[]
  analytics          ReviewAnalytics[]
}

model PrivateFeedback {
  id            String   @id @default(cuid())
  businessId    String
  rating        Int
  customerName  String?
  customerEmail String?
  customerPhone String?
  comments      String
  status        String   @default("NEW") // "NEW" | "CONTACTED" | "RESOLVED"
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ReviewAnalytics {
  id         String   @id @default(cuid())
  businessId String
  eventType  String   // "PAGE_VIEW" | "STAR_SELECTED" | "AI_GENERATED" | "GOOGLE_REDIRECT" | "FEEDBACK_SUBMITTED"
  rating     Int?
  deviceType String?  // "mobile" | "desktop"
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model UpiPayment {
  id            String   @id @default(cuid())
  userId        String
  businessId    String?
  agentId       String?  // If sale was closed by a field marketing agent
  agentCode     String?  // E.g. "MKT-01"
  planType      String   @default("MONTHLY_299") // "MONTHLY_299" | "LIFETIME_999" | "ADDON_BRANCH" | "NEGOTIATED_DEAL"
  amount        Float    @default(299)
  utrNumber     String   // 12-digit UPI reference number
  customerPhone String?
  status        String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformSetting {
  id                 String   @id @default("default")
  platformName       String   @default("ReviewSmart AI")
  supportEmail       String   @default("momopedeals@gmail.com")
  customDomain       String?
  currencySymbol     String   @default("₹")
  upiId              String   @default("momopedeals@oksbi")
  upiPayeeName       String   @default("Damerla Mohan")
  digitalPrice       Float    @default(299) // 1 Month Pass
  physicalPrice      Float    @default(999) // 1 Year / Lifetime Pass
  minNegotiatedPrice Float    @default(499) // Hard floor for agent deals
  updatedAt          DateTime @updatedAt
}
