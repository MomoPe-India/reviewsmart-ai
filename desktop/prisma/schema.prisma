// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "./generated-client"
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows"]
}

// ─── USER ─────────────────────────────────────────────────────────────────────
model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String?
  password       String
  userIdTag      String?           @unique
  pinCode        String?
  phone          String?
  role           String            @default("BUSINESS_OWNER")
  agentCode      String?
  commissionRate Float?
  referredBy     String?
  customerType   String            @default("OFFLINE")
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  businesses     Business[]
  subscription   UserSubscription?
  upiPayments    UpiPayment[]
}

model SubscriptionPlan {
  id            String             @id @default(cuid())
  name          String
  price         Float              @default(0)
  currency      String             @default("INR")
  durationDays  Int                @default(365)
  maxCards      Int                @default(1)
  features      String             @default("[\"AI Review Generation\",\"Negative Review Shield\",\"Smart QR Code\"]")
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions UserSubscription[]
}

model UserSubscription {
  id        String           @id @default(cuid())
  userId    String           @unique
  planId    String
  status    String           @default("ACTIVE")
  startDate DateTime         @default(now())
  endDate   DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
}

// ─── BUSINESS ─────────────────────────────────────────────────────────────────
model Business {
  id                    String   @id @default(cuid())
  userId                String
  name                  String
  slug                  String   @unique
  tagline               String?  @default("Review our service & share your experience!")
  category              String?  @default("Local Business")
  customerType          String   @default("OFFLINE")
  logoUrl               String?
  primaryColor          String   @default("#4f46e5")
  googlePlaceId         String?
  googleReviewUrl       String?
  googleAddress         String?
  phone                 String?
  whatsapp              String?
  instagram             String?
  facebook              String?
  website               String?
  minRatingForGoogle    Int      @default(4)
  keywords              String   @default("exceptional service, highly recommended, friendly staff, prompt delivery, great experience")
  tagChips              String   @default("Friendly Staff,Fast Service,Great Quality,Fair Pricing,Clean Ambiance")
  reviewPromptTone      String   @default("friendly")
  qrMode                String   @default("SMART_HUB")
  menuUrl               String?
  customUpiId           String?
  packageTier           String   @default("EXECUTIVE_STANDEE")
  visitingCardBackMode  String?  @default("BUSINESS_CARD")
  visitingCardOwnerName String?
  visitingCardOwnerTitle String?
  visitingCardPhone     String?
  visitingCardEmail     String?
  visitingCardAddress   String?
  visitingCardImageUrl  String?
  isPaid                Boolean  @default(false)
  demoExpiresAt         DateTime?
  demoActivatedAt       DateTime?
  demoActivatedBy       String?
  demoUsed              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks       PrivateFeedback[]
  analytics       ReviewAnalytics[]
  reviewMemories  GeneratedReviewMemory[]
}

model PrivateFeedback {
  id            String   @id @default(cuid())
  businessId    String
  rating        Int
  customerName  String?
  customerEmail String?
  customerPhone String?
  comments      String
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ReviewAnalytics {
  id         String   @id @default(cuid())
  businessId String
  eventType  String
  rating     Int?
  deviceType String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── UPI PAYMENT ──────────────────────────────────────────────────────────────
model UpiPayment {
  id             String   @id @default(cuid())
  userId         String
  businessId     String?
  agentId        String?
  agentCode      String?
  planType       String   @default("NEGOTIATED_DEAL")
  amount         Float    @default(1999)
  utrNumber      String
  customerPhone  String?
  status         String   @default("PENDING")
  commission     Float?
  commissionPaid Boolean  @default(false)
  packageTier    String?  @default("EXECUTIVE_STANDEE")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── PLATFORM SETTINGS ────────────────────────────────────────────────────────
model PlatformSetting {
  id                 String   @id @default("default")
  platformName       String   @default("ReviewSmart AI")
  supportEmail       String   @default("momopedeals@gmail.com")
  supportWhatsapp    String   @default("+918639831132")
  customDomain       String?
  currencySymbol     String   @default("₹")
  upiId              String   @default("momopedeals@oksbi")
  upiPayeeName       String   @default("Damerla Mohan")
  minNegotiatedPrice Float    @default(1999)
  commissionRate     Float    @default(0.30)
  updatedAt          DateTime @updatedAt
}

// ─── GENERATED REVIEW MEMORY ──────────────────────────────────────────────────
model GeneratedReviewMemory {
  id            String   @id @default(cuid())
  businessId    String?
  businessName  String
  category      String?
  reviewText    String
  openingPhrase String
  closingPhrase String
  structureTag  String
  writingStyle  String
  languageMix   String
  tagsUsed      String?
  ngramHash     String?
  createdAt     DateTime @default(now())

  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([openingPhrase])
  @@index([structureTag])
  @@index([createdAt])
}
